// Typprüfung der Vite-Konfiguration (#64). Sie läuft unter Node und nicht im Browser, braucht
// also Node-Typen statt DOM und gehört deshalb nicht in tsconfig.json, die nur `src` prüft.
// Strenge Einstellungen wie dort; aufgerufen über `npm run typecheck`.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}

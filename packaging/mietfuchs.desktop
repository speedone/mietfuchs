# Kein Konsolenfenster: Mietfuchs wird im Browser bedient, und mit Terminal=true startet auf
# Systemen ohne Terminalprogramm gar nichts („Unable to find terminal required for application“).
# Beendet wird über den Knopf in der Seitenleiste, ein zweiter Klick im Menü holt die laufende
# Oberfläche nach vorn, und misslingt der Start, meldet sich Mietfuchs per Systemmeldung (#45).
Terminal=false
